import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
# Ganti nama file sesuai dengan nama file Excel Anda (misal: data.xlsx)
df = pd.read_excel('Asia Selatan.xlsx')
df.head() # Menampilkan 5 data paling atas
country_list = [
    'India',
    'Pakistan',
    'Bangladesh',
    "Sri Lanka",
    'Nepal',
    'Bhutan',
    'Maldives',
    'Afghanistan'
] # Definisikan negara yang ingin di cari tau
filtered_df = df[df['Country Name'].isin(country_list)]
filtered_df = filtered_df.set_index('Country Name')

filtered_df.head()
#Menyusun EWMA Baru
train_selected_years_df = filtered_df.loc[:, '1991':'1995']
mu_0 = train_selected_years_df.mean(axis=1) # Target Mean (mu0)
sigma_0 = train_selected_years_df.std(axis=1) # Historical Std Dev (sigma0)

test_selected_years_df = filtered_df.loc[:, '1996':'2001']
# 2. Mendefinisikan parameter EWMA
lambda_weight = 0.1
L = 3

# 3. Menghitung EWMA dengan Z_0 = mu_0
# Triknya: Kita sisipkan mu_0 di awal data sebelum menghitung ewm(), lalu kita hapus lagi
temp_df = pd.concat([mu_0.rename('mu_0'), test_selected_years_df], axis=1)
ewma_df = temp_df.T.ewm(alpha=lambda_weight, adjust=False).mean().T
ewma_df = ewma_df.drop(columns=['mu_0']) # Hapus kolom mu_0 agar kolomnya pas dengan 2001-2010

# 4. Memodifikasi fungsi control_limits agar menerima mu_0 dan sigma_0 sebagai input
def control_limits(selected_years_df, mu, sigma, lambda_weight=0.2, L=3):

    # Menentukan panjang data yang ditinjau
    num_years = len(selected_years_df.columns)
    i = np.arange(1, num_years + 1)

    # Menghitung time factor
    time_factor = np.sqrt((lambda_weight/(2-lambda_weight))*(1-(1-lambda_weight)**(2*i)))

    # Menghitung penyebaran batasnya menggunakan sigma_0 (dari input argumen)
    limit_spread = L * sigma.values[:, np.newaxis] * time_factor

    # Menghitung batas menggunakan mu_0 (dari input argumen)
    ucl_values = mu.values[:, np.newaxis] + limit_spread
    lcl_values = mu.values[:, np.newaxis] - limit_spread

    # Membuat dataframe
    ucl_df = pd.DataFrame(ucl_values, index=selected_years_df.index, columns=selected_years_df.columns)
    lcl_df = pd.DataFrame(lcl_values, index=selected_years_df.index, columns=selected_years_df.columns)

    return ucl_df, lcl_df
import os # Pastikan modul os di-import untuk membuat folder

def plot_all_ewma(selected_years_df, ewma_df, ucl_df, lcl_df, target_mu, save_dir="EWMA_Charts"):

    # Membuat folder baru jika belum ada
    if not os.path.exists(save_dir):
        os.makedirs(save_dir)

    years = selected_years_df.columns

    # Looping untuk masing-masing negara
    for country in selected_years_df.index:
        plt.figure(figsize=(10, 5))

        actual = selected_years_df.loc[country]
        ewma_stat = ewma_df.loc[country]
        ucl = ucl_df.loc[country]
        lcl = lcl_df.loc[country]

        mu_center = target_mu.loc[country]

        plt.plot(years, actual, marker='o', linestyle='--', color='gray', label='Actual Rate', alpha=0.5)
        plt.plot(years, ewma_stat, marker='s', linestyle='-', color='blue', label='EWMA Statistic', linewidth=2)

        plt.axhline(mu_center, color='green', linestyle='-', label=f'Center Line (\u03bc0: {mu_center:.2f})')
        plt.plot(years, ucl, color='red', linestyle='--', label='UCL')
        plt.plot(years, lcl, color='red', linestyle='--', label='LCL')

        plt.title(f'EWMA Control Chart: {country}', fontsize=14, fontweight='bold')
        plt.xlabel('Year', fontsize=12)
        plt.ylabel('Unemployment Rate (%)', fontsize=12)
        plt.xticks(rotation=45)
        plt.grid(True, linestyle=':', alpha=0.6)

        plt.legend(bbox_to_anchor=(1.04, 1), loc='upper left')
        plt.tight_layout()

        # --- KODE BARU UNTUK SAVE GAMBAR ---
        # Menyimpan gambar dengan nama file spesifik per negara
        file_path = os.path.join(save_dir, f'EWMA_{country}.png')
        plt.savefig(file_path, dpi=300, bbox_inches='tight')

        # Menampilkan plot
        plt.show()
# PANGGIL FUNGSI INI DULU UNTUK MENGUPDATE NILAI UCL DAN LCL
ucl_df, lcl_df = control_limits(test_selected_years_df, mu=mu_0, sigma=sigma_0, lambda_weight=lambda_weight, L=L)

# BARU SETELAH ITU PLOT GRAFIKNYA
plot_all_ewma(test_selected_years_df, ewma_df, ucl_df, lcl_df, mu_0)

# Menyusun CUSUM 
# 1. Definisikan Parameter CUSUM (Silakan diedit sesuai kebutuhan)
k_factor = 0.5  # Slack value (biasanya 0.5)
h_factor = 4.0  # Control limit multiplier (biasanya 4 atau 5)

# Menghitung K (Allowance) dan H (Control Limit) absolut per negara
K_allowance = k_factor * sigma_0
H_limit = h_factor * sigma_0

# 2. Inisialisasi DataFrame kosong berisi angka 0 untuk C+ dan C-
c_plus_df = pd.DataFrame(0.0, index=test_selected_years_df.index, columns=test_selected_years_df.columns)
c_minus_df = pd.DataFrame(0.0, index=test_selected_years_df.index, columns=test_selected_years_df.columns)

years = test_selected_years_df.columns

for i, year in enumerate(years):
    x_i = test_selected_years_df[year]

    if i == 0:
        # Perhitungan tahun pertama (2001), tidak ada akumulasi tahun sebelumnya
        c_plus_df[year] = np.maximum(0, x_i - (mu_0 + K_allowance))
        c_minus_df[year] = np.maximum(0, (mu_0 - K_allowance) - x_i)
    else:
        # Perhitungan tahun berikutnya, ditambah nilai kumulatif tahun sebelumnya
        prev_year = years[i-1]
        c_plus_df[year] = np.maximum(0, x_i - (mu_0 + K_allowance) + c_plus_df[prev_year])
        c_minus_df[year] = np.maximum(0, (mu_0 - K_allowance) - x_i + c_minus_df[prev_year])

print("--- Data C+ (Beberapa Baris Pertama) ---")
display(c_plus_df.head())
print("\n--- Data C- (Beberapa Baris Pertama) ---")
display(c_minus_df.head())

import os
import matplotlib.pyplot as plt

# --- PART 2: FUNGSI PLOTTING TABULAR CUSUM ---

def plot_tabular_cusum(c_plus_df, c_minus_df, h_limit_series, save_dir="CUSUM_Charts"):

    # Membuat folder baru jika belum ada
    if not os.path.exists(save_dir):
        os.makedirs(save_dir)

    years = c_plus_df.columns

    for country in c_plus_df.index:
        plt.figure(figsize=(10, 5))

        # 1. Ambil data spesifik per negara
        c_plus = c_plus_df.loc[country]

        # Trik: Kalikan C- dengan -1 agar grafiknya turun ke bawah
        c_min = c_minus_df.loc[country] * -1

        # Ambil nilai batas kendali (H)
        H_lim = h_limit_series.loc[country]

        # 2. Plot Garis C+ dan C-
        plt.plot(years, c_plus, marker='^', linestyle='-', color='blue', label='C+ (Upper CUSUM)', linewidth=2)
        plt.plot(years, c_min, marker='v', linestyle='-', color='orange', label='C- (Lower CUSUM)', linewidth=2)

        # 3. Plot Garis Tengah (0) dan Batas Kendali (H dan -H)
        plt.axhline(0, color='black', linestyle='-', linewidth=1.5, alpha=0.7, label='Center Line (0)')
        plt.axhline(H_lim, color='red', linestyle='--', label=f'UCL (H = {H_lim:.2f})')
        plt.axhline(-H_lim, color='red', linestyle='--', label=f'LCL (-H = {-H_lim:.2f})')

        # 4. Pengaturan Visual Plot
        plt.title(f'Tabular CUSUM Chart: {country}', fontsize=14, fontweight='bold')
        plt.xlabel('Year', fontsize=12)
        plt.ylabel('Cumulative Sum', fontsize=12)
        plt.xticks(rotation=45)
        plt.grid(True, linestyle=':', alpha=0.6)

        # Area arsiran merah (opsional) untuk memperjelas area out-of-control
        # plt.fill_between(years, H_lim, c_plus.max() + 1, color='red', alpha=0.05)
        # plt.fill_between(years, -H_lim, c_min.min() - 1, color='red', alpha=0.05)

        plt.legend(bbox_to_anchor=(1.04, 1), loc='upper left')
        plt.tight_layout()

        # 5. Save Gambar ke Folder
        file_path = os.path.join(save_dir, f'CUSUM_{country}.png')
        plt.savefig(file_path, dpi=300, bbox_inches='tight')

        plt.show()

# --- PART 3: MENJALANKAN PLOT UNTUK SEMUA NEGARA ---

# Panggil fungsi plotting dengan memasukkan DataFrame C+, C-, dan series batas H
plot_tabular_cusum(c_plus_df, c_minus_df, H_limit)

# --- PART 1: MENGHITUNG BATAS KENDALI SHEWHART ---

# 1. Definisikan pengali L (standarnya 3 untuk 3-sigma)
L_shewhart = 3

# 2. Hitung Upper Control Limit (UCL) dan Lower Control Limit (LCL)
# Karena ini data Individual (bukan rata-rata subgrup), formulanya: mu0 +- 3*sigma0
shewhart_ucl = mu_0 + (L_shewhart * sigma_0)
shewhart_lcl = mu_0 - (L_shewhart * sigma_0)
# 3. (Opsional tapi Penting) Mencegah LCL bernilai negatif
# Tingkat pengangguran (unemployment rate) tidak mungkin di bawah 0%.
# Kode ini akan mengubah nilai LCL yang negatif menjadi 0.
shewhart_lcl = shewhart_lcl.apply(lambda x: max(x, 0))

# Menampilkan hasil perhitungan batas kendali
print("--- Shewhart Control Limits (Per Country) ---")
batas_kendali_df = pd.DataFrame({
    'LCL': shewhart_lcl,
    'Center Line (mu0)': mu_0,
    'UCL': shewhart_ucl
})
display(batas_kendali_df.head())

